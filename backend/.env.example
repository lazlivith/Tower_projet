DATABASE_URL=postgresql://user:password@localhost:5432/towerweb
JWT_SECRET=your-super-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PORT=5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TowerStructure <noreply@towerstructure.ma>"
UPLOAD_DIR=./uploads
NODE_ENV=development

# Cloudinary — gestion des médias (images, PDF/documents, vidéos de cours).
# Récupérer depuis https://console.cloudinary.com/  (Dashboard → API Keys).
# Fournir SOIT CLOUDINARY_URL seul, SOIT le trio ci-dessous.
# Si rien n'est renseigné : stockage disque local (dev).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
# CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_FOLDER=tower
# Stripe — Récupérer ces clés depuis https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jitsi Meet — laisser JITSI_APP_SECRET vide pour utiliser meet.jit.si en salle publique (sans JWT)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=towerstructure
JITSI_APP_SECRET=
